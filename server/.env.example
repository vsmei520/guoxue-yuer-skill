# 服务端基础配置
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://guoxue.073955.com

# PostgreSQL 数据库
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=guoxue_db
DB_USER=guoxue_user
DB_PASSWORD=请填写数据库密码
DB_POOL_MAX=10

# 管理员登录
# 使用 server/scripts/create-password-hash.js 生成哈希后填写
ADMIN_PASSWORD_HASH=请填写管理员密码哈希
ADMIN_SESSION_SECRET=请填写一段随机字符串

# 授权令牌有效期
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# 服务器统一 AI 配置，只填写服务器，不向用户索取
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=请填写服务器AI密钥
OPENAI_MODEL=gpt-4o-mini

# 如果使用 Claude，将 AI_PROVIDER 改为 claude，并填写下面三项
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 私有 Skill 文件目录
SKILL_FILES_PATH=./skills
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=120000

# 请求限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
